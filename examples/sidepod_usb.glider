          "unit": "seconds"
        },
        "device_id": null,
        "visible_in_runner": false
      },
      {
        "id": "puff",
        "node_type": "VapePod",
        "position": [
          750,
          0
        ],
        "state": {
          "mode": "puff",
          "duration_ms": 3000,
          "power": 50,
          "pump_percent": 100
        },
        "device_id": "side_pod",
        "visible_in_runner": false
      },
      {
        "id": "hold_puff",
        "node_type": "Delay",
        "position": [
          1000,
          0
        ],
        "state": {
          "duration": 3.0,
          "unit": "seconds"
        },
        "device_id": null,
        "visible_in_runner": false
      },
      {
        "id": "all_off",
        "node_type": "VapePod",
        "position": [
          1250,
          0
        ],
        "state": {
          "mode": "off",
          "duration_ms": 3000,
          "power": 50,
          "pump_percent": 100
