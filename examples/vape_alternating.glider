{
  "metadata": {
    "id": "a5299e43-1e22-45b0-b1e9-342f2d9593e1",
    "name": "Vape alternating sides (1 min)",
    "description": "Alternates the two sides of the vape box. PiBox side: pump + atomizer (50 %, 127/255) for 2 s, then 10 s wait, then side pod (VapePodUSB): pump + 2 s puff at 50 %, then all off. One cycle every 24 s, 3 cycles: puffs at 0, 12, 24, 36, 48 and 60 s; ends at 72 s.",
    "author": "",
    "version": "1.0.0",
    "created_at": "2026-11-17T14:27:41.357802",
    "modified_at": "2026-11-17T14:27:41.357802",
    "glider_version": "1.0.0",
    "protocol": "",
    "experiment_type": "",
    "experimenter": "",
    "lab": "",
    "project": "",
