/*
 * GLIDER Desktop Stylesheet
 * Deep Navy dark theme for the Builder IDE
 */

/* === Global === */
QWidget {
    background-color: #0f1419;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 12px;
}

/* === Main Window === */
QMainWindow {
    background-color: #0f1419;
}

QMainWindow::separator {
    background-color: #1e2530;
    width: 2px;
    height: 2px;
}

QMainWindow::separator:hover {
    background-color: #38bdf8;
}

/* === Menu Bar === */
QMenuBar {
    background-color: #0b0f14;
    border-bottom: 1px solid #1e2530;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e2530;
}

QMenuBar::item:pressed {
    background-color: #38bdf8;
}

QMenu {
    background-color: #0f1419;
    border: 1px solid #1e2530;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #38bdf8;
}

QMenu::separator {
    height: 1px;
    background-color: #1e2530;
    margin: 4px 8px;
}

/* === Tool Bar === */
QToolBar {
    background-color: #0b0f14;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #1e2530;
    width: 1px;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QToolButton:hover {
    background-color: #1e2530;
}

QToolButton:pressed {
    background-color: #38bdf8;
}

QToolButton:checked {
    background-color: #1e2530;
    border: 1px solid #38bdf8;
}

/* === Dock Widgets === */
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(float.png);
}

QDockWidget::title {
    background-color: #0b0f14;
    padding: 8px;
    border-bottom: 1px solid #1e2530;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #1e2530;
    border-radius: 4px;
}

/* === Tab Widget === */
QTabWidget::pane {
    border: 1px solid #1e2530;
    background-color: #0f1419;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #0b0f14;
    color: #718096;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0f1419;
    color: #e2e8f0;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background-color: #1e2530;
}

/* === Scroll Area === */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #1e2530;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2a3440;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #1e2530;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2a3440;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Push Button === */
QPushButton {
    background-color: #38bdf8;
    color: #e2e8f0;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #0ea5e9;
}

QPushButton:pressed {
    background-color: #0284c7;
}

QPushButton:disabled {
    background-color: #1e2530;
    color: #475569;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #38bdf8;
}

QPushButton[flat="true"]:hover {
    background-color: rgba(56, 189, 248, 0.1);
}

/* === Line Edit === */
QLineEdit {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #38bdf8;
}

QLineEdit:focus {
    border-color: #38bdf8;
}

QLineEdit:disabled {
    background-color: #0a0e13;
    color: #475569;
}

/* === Text Edit / Plain Text Edit === */
QTextEdit,
QPlainTextEdit {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #38bdf8;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #38bdf8;
}

/* === Spin Box === */
QSpinBox,
QDoubleSpinBox {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 6px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #38bdf8;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    background-color: #1e2530;
    border-top-right-radius: 6px;
    width: 20px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover {
    background-color: #38bdf8;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #1e2530;
    border-bottom-right-radius: 6px;
    width: 20px;
}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #38bdf8;
}

/* === Combo Box === */
QComboBox {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    min-width: 100px;
}

QComboBox:focus {
    border-color: #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #0f1419;
    border: 1px solid #1e2530;
    border-radius: 4px;
    selection-background-color: #38bdf8;
}

/* === Check Box === */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #1e2530;
    border-radius: 4px;
    background-color: #0b0f14;
}

QCheckBox::indicator:checked {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

QCheckBox::indicator:hover {
    border-color: #38bdf8;
}

/* === Radio Button === */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #1e2530;
    border-radius: 9px;
    background-color: #0b0f14;
}

QRadioButton::indicator:checked {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

QRadioButton::indicator:hover {
    border-color: #38bdf8;
}

/* === Slider === */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #1e2530;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    background-color: #38bdf8;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #0ea5e9;
}

QSlider::groove:vertical {
    width: 6px;
    background-color: #1e2530;
    border-radius: 3px;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -5px;
    background-color: #38bdf8;
    border-radius: 8px;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #1e2530;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #38bdf8;
    border-radius: 4px;
}

/* === Group Box === */
QGroupBox {
    border: none;
    border-top: 2px solid #1e2530;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #718096;
}

/* === List View / Tree View === */
QListView,
QTreeView,
QTableView {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 4px;
    alternate-background-color: #0f1419;
}

QListView::item,
QTreeView::item,
QTableView::item {
    padding: 6px;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #38bdf8;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #1e2530;
}

QHeaderView::section {
    background-color: #0b0f14;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #1e2530;
    border-right: 1px solid #1e2530;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #1e2530;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

/* === Status Bar === */
QStatusBar {
    background-color: #0b0f14;
    border-top: 1px solid #1e2530;
}

QStatusBar::item {
    border: none;
}

/* === Tool Tip === */
QToolTip {
    background-color: #1e2530;
    color: #e2e8f0;
    border: 1px solid #2a3440;
    border-radius: 4px;
    padding: 4px 8px;
}

/* === Frame === */
QFrame[frameShape="4"] { /* HLine */
    background-color: #1e2530;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background-color: #1e2530;
    max-width: 1px;
}

/* === Label === */
QLabel {
    background-color: transparent;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #e2e8f0;
}

QLabel[subheading="true"] {
    font-size: 14px;
    color: #718096;
}

/* === Graphics View (Node Editor) === */
QGraphicsView {
    background-color: #0a0e13;
    border: 1px solid #1e2530;
    border-radius: 4px;
}

/* === Custom Classes === */
/* Node palette */
.NodePalette {
    background-color: #0b0f14;
    border-right: 1px solid #1e2530;
}

/* Property panel */
.PropertyPanel {
    background-color: #0b0f14;
    border-left: 1px solid #1e2530;
}

/* Console output */
.ConsoleOutput {
    font-family: "SF Mono", "Menlo", "Consolas", "Monaco", "Courier New";
    background-color: #0a0e13;
}

/* === Node Library Buttons === */
QPushButton[nodeCategory="Flow"] {
    background-color: #1e3a5f;
    color: #e2e8f0;
    border: none;
    padding: 8px 12px;
    text-align: left;
    border-radius: 4px;
    margin: 1px 0px;
}

QPushButton[nodeCategory="Flow"]:hover {
    background-color: #2a4a70;
}

QPushButton[nodeCategory="Control"] {
    background-color: #4a3a1a;
    color: #e2e8f0;
    border: none;
    padding: 8px 12px;
    text-align: left;
    border-radius: 4px;
    margin: 1px 0px;
}

QPushButton[nodeCategory="Control"]:hover {
    background-color: #5a4a2a;
}

QPushButton[nodeCategory="I/O"] {
    background-color: #1a4a2e;
    color: #e2e8f0;
    border: none;
    padding: 8px 12px;
    text-align: left;
    border-radius: 4px;
    margin: 1px 0px;
}

QPushButton[nodeCategory="I/O"]:hover {
    background-color: #2a5a3e;
}

QPushButton[nodeButton="true"]:pressed {
    background-color: #151c25;
}

/* === Node Category Headers === */
QLabel[categoryHeader="true"] {
    background-color: #1e2530;
    color: #e2e8f0;
    padding: 6px;
    font-weight: bold;
    border-radius: 4px;
}

QLabel[categoryHeader="Flow"] {
    background-color: #1e3a5f;
}

QLabel[categoryHeader="Control"] {
    background-color: #4a3a1a;
}

QLabel[categoryHeader="I/O"] {
    background-color: #1a4a2e;
}

/* === Security Warning === */
QLabel[securityWarning="true"] {
    background-color: rgba(248, 113, 113, 0.15);
    color: #f87171;
    padding: 8px;
    border-radius: 4px;
    font-weight: bold;
}

/* === Code Editor === */
QPlainTextEdit[codeEditor="true"] {
    font-family: "SF Mono", "Menlo", "Consolas", "Monaco", "Courier New";
    font-size: 12px;
    background-color: #0a0e13;
    color: #e2e8f0;
    border: 1px solid #1e2530;
    border-radius: 4px;
}

/* === Runner View Elements === */
QWidget[runnerHeader="true"] {
    background-color: #0b0f14;
    border-radius: 8px;
}

QWidget[runnerControls="true"] {
    background-color: #0b0f14;
    border-radius: 12px;
}

/* === Runner Control Buttons === */
QPushButton[runnerAction="start"] {
    background-color: #34d399;
    color: #e2e8f0;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

QPushButton[runnerAction="start"]:pressed {
    background-color: #22a57a;
}

QPushButton[runnerAction="stop"] {
    background-color: #718096;
    color: #e2e8f0;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

QPushButton[runnerAction="stop"]:pressed {
    background-color: #5a6878;
}

QPushButton[runnerAction="emergency"] {
    background-color: rgba(248, 113, 113, 0.2);
    color: #f87171;
    font-size: 18px;
    font-weight: bold;
    border-radius: 12px;
    border: 2px solid #f87171;
}

QPushButton[runnerAction="emergency"]:pressed {
    background-color: rgba(248, 113, 113, 0.35);
}

/* === Runner Status (Larger) === */
QLabel[runnerStatus="true"] {
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: bold;
}

/* === Dynamic Property Selectors === */

/* Text roles */
QLabel[textRole="muted"] { color: #718096; font-size: 11px; }
QLabel[textRole="section"] { color: #718096; font-size: 10px; font-weight: bold; }
QLabel[textRole="secondary"] { color: #94a3b8; }
QLabel[textRole="disabled"] { color: #475569; }
QLabel[textRole="primary"] { color: #e2e8f0; }

/* Button roles */
QPushButton[buttonRole="secondary"] { background-color: #1e2530; color: #94a3b8; }
QPushButton[buttonRole="secondary"]:hover { background-color: #2a3440; }
QPushButton[buttonRole="secondary"]:pressed { background-color: #151c25; }
QPushButton[buttonRole="danger"] { background-color: rgba(248, 113, 113, 0.15); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); }
QPushButton[buttonRole="danger"]:hover { background-color: rgba(248, 113, 113, 0.25); }

/* Recording indicator */
QLabel[recording="true"] { background-color: rgba(248, 113, 113, 0.2); color: #f87171; padding: 2px 8px; border-radius: 8px; font-size: 11px; font-weight: bold; }

/* Input value display */
QLabel[inputValue="true"] { background-color: #151c25; border-radius: 4px; color: #34d399; padding: 4px 8px; }

/* Properties panel section headers */
QLabel[class="props-section-header"] {
    color: #718096;
    font-size: 10px;
    font-weight: bold;
    padding-top: 4px;
    padding-bottom: 2px;
}

/* Properties panel dividers */
QFrame[class="props-divider"] {
    color: #1e2530;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Device card */
QWidget[deviceCard="true"] { background-color: #0f1419; border: 2px solid #1e2530; border-radius: 12px; }

/* Status states */
QLabel[statusIndicator="true"] { color: #e2e8f0; padding: 4px 12px; border-radius: 4px; font-weight: bold; margin: 2px; }
QLabel[statusState="IDLE"] { background-color: #1e2530; }
QLabel[statusState="READY"] { background-color: rgba(52, 211, 153, 0.15); color: #34d399; }
QLabel[statusState="RUNNING"] { background-color: rgba(56, 189, 248, 0.15); color: #38bdf8; }
QLabel[statusState="PAUSED"], QLabel[statusState="STOPPING"] { background-color: rgba(251, 191, 36, 0.15); color: #fbbf24; }
QLabel[statusState="ERROR"] { background-color: rgba(248, 113, 113, 0.15); color: #f87171; }
QLabel[statusState="INITIALIZING"] { background-color: rgba(96, 165, 250, 0.15); color: #60a5fa; }
