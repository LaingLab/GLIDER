/*
 * GLIDER Desktop Stylesheet
 * Deep Navy dark theme for the Builder IDE
 */

/* === Global === */
QWidget {
    background-color: #0f1419;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
    font-size: 12px;
}

/* === Main Window === */
QMainWindow {
    background-color: #0f1419;
}

/* Blend dock separators into the panel background so butting panels read as a
 * subtle surface step, not a contrasting hairline. The :hover cyan still
 * reveals the drag handle when resizing docks. */
QMainWindow::separator {
    background-color: #0f1419;
    width: 1px;
    height: 1px;
}

QMainWindow::separator:hover {
    background-color: #38bdf8;
}

/* === Menu Bar === */
QMenuBar {
    background-color: #0b0f14;
    border-bottom: 1px solid #1e2530;
    padding: 2px;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e2530;
}

QMenuBar::item:pressed {
    background-color: #38bdf8;
}

QMenu {
    background-color: #0f1419;
    border: 1px solid #1e2530;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #38bdf8;
}

QMenu::separator {
    height: 1px;
    background-color: #1e2530;
    margin: 4px 8px;
}

/* === Tool Bar === */
QToolBar {
    background-color: #0b0f14;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #1e2530;
    width: 1px;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QToolButton:hover {
    background-color: #1e2530;
}

QToolButton:pressed {
    background-color: #38bdf8;
}

QToolButton:checked {
    background-color: #1e2530;
    border: 1px solid #38bdf8;
}

/* === Dock Widgets === */
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(float.png);
}

QDockWidget::title {
    background-color: #0b0f14;
    padding: 8px;
    border-bottom: 1px solid #1e2530;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #1e2530;
    border-radius: 4px;
}

/* === Tab Widget === */
QTabWidget::pane {
    border: 1px solid #1e2530;
    background-color: #0f1419;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #0b0f14;
    color: #718096;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0f1419;
    color: #e2e8f0;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background-color: #1e2530;
}

/* === Scroll Area === */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #1e2530;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2a3440;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #1e2530;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2a3440;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Push Button === */
QPushButton {
    background-color: #38bdf8;
    color: #e2e8f0;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #0ea5e9;
}

QPushButton:pressed {
    background-color: #0284c7;
}

QPushButton:disabled {
    background-color: #1e2530;
    color: #475569;
}

QPushButton[flat="true"] {
    background-color: transparent;
    color: #38bdf8;
}

QPushButton[flat="true"]:hover {
    background-color: rgba(56, 189, 248, 0.1);
}

/* === Line Edit === */
QLineEdit {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #38bdf8;
}

QLineEdit:focus {
    border-color: #38bdf8;
}

QLineEdit:disabled {
    background-color: #0a0e13;
    color: #475569;
}

/* === Text Edit / Plain Text Edit === */
QTextEdit,
QPlainTextEdit {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #38bdf8;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #38bdf8;
}

/* === Spin Box === */
QSpinBox,
QDoubleSpinBox {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 6px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #38bdf8;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    background-color: #1e2530;
    border-top-right-radius: 6px;
    width: 20px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover {
    background-color: #38bdf8;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: #1e2530;
    border-bottom-right-radius: 6px;
    width: 20px;
}

QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #38bdf8;
}

/* === Combo Box === */
QComboBox {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    min-width: 100px;
}

QComboBox:focus {
    border-color: #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #0f1419;
    border: 1px solid #1e2530;
    border-radius: 4px;
    selection-background-color: #38bdf8;
}

/* === Check Box === */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #1e2530;
    border-radius: 4px;
    background-color: #0b0f14;
}

QCheckBox::indicator:checked {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

QCheckBox::indicator:hover {
    border-color: #38bdf8;
}

/* === Radio Button === */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #1e2530;
    border-radius: 9px;
    background-color: #0b0f14;
}

QRadioButton::indicator:checked {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

QRadioButton::indicator:hover {
    border-color: #38bdf8;
}

/* === Slider === */
QSlider::groove:horizontal {
    height: 6px;
    background-color: #1e2530;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    background-color: #38bdf8;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #0ea5e9;
}

QSlider::groove:vertical {
    width: 6px;
    background-color: #1e2530;
    border-radius: 3px;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -5px;
    background-color: #38bdf8;
    border-radius: 8px;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #1e2530;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #38bdf8;
    border-radius: 4px;
}

/* === Group Box === */
QGroupBox {
    border: none;
    border-top: 2px solid #1e2530;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #718096;
}

/* === List View / Tree View === */
QListView,
QTreeView,
QTableView {
    background-color: #0b0f14;
    border: 1px solid #1e2530;
    border-radius: 4px;
    alternate-background-color: #0f1419;
}

QListView::item,
QTreeView::item,
QTableView::item {
    padding: 6px;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #38bdf8;
}

QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #1e2530;
}

QHeaderView::section {
    background-color: #0b0f14;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #1e2530;
    border-right: 1px solid #1e2530;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #1e2530;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #38bdf8;
}

/* === Status Bar === */
QStatusBar {
    background-color: #0b0f14;
    border-top: 1px solid #1e2530;
}

QStatusBar::item {
    border: none;
}

/* === Tool Tip === */
QToolTip {
    background-color: #1e2530;
    color: #e2e8f0;
    border: 1px solid #2a3440;
    border-radius: 4px;
    padding: 4px 8px;
}

/* === Frame === */
QFrame[frameShape="4"] { /* HLine */
    background-color: #1e2530;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background-color: #1e2530;
    max-width: 1px;
}

/* === Label === */
QLabel {
    background-color: transparent;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #e2e8f0;
}

QLabel[subheading="true"] {
    font-size: 14px;
    color: #718096;
}

/* === Graphics View (Node Editor) === */
/* No border: the canvas is delineated by its darker surface (#0a0e13 vs the
 * #0f1419 docks), which reads as recessed depth instead of a contrasting
 * hairline that stacks with the dock separator at panel boundaries. */
QGraphicsView {
    background-color: #0a0e13;
    border: none;
}

/* === Custom Classes === */
/* Console output */
.ConsoleOutput {
    font-family: "SF Mono", "Menlo", "Consolas", "Monaco", "Courier New";
    background-color: #0a0e13;
}

/* === Node Library Buttons === */
QPushButton[nodeCategory="Flow"] {
    background-color: #1e3a5f;
    color: #e2e8f0;
    border: none;
    padding: 8px 12px;
    text-align: left;
    border-radius: 4px;
    margin: 1px 0px;
}

QPushButton[nodeCategory="Flow"]:hover {
    background-color: #2a4a70;
}

QPushButton[nodeCategory="Control"] {
    background-color: #4a3a1a;
    color: #e2e8f0;
    border: none;
    padding: 8px 12px;
    text-align: left;
    border-radius: 4px;
    margin: 1px 0px;
}

QPushButton[nodeCategory="Control"]:hover {
    background-color: #5a4a2a;
}

QPushButton[nodeCategory="I/O"] {
    background-color: #1a4a2e;
    color: #e2e8f0;
    border: none;
    padding: 8px 12px;
    text-align: left;
    border-radius: 4px;
    margin: 1px 0px;
}

QPushButton[nodeCategory="I/O"]:hover {
    background-color: #2a5a3e;
}

QPushButton[nodeButton="true"]:pressed {
    background-color: #151c25;
}

/* === Node Category Headers === */
QLabel[categoryHeader="true"] {
    background-color: #1e2530;
    color: #e2e8f0;
    padding: 6px;
    font-weight: bold;
    border-radius: 4px;
}

QLabel[categoryHeader="Flow"] {
    background-color: #1e3a5f;
}

QLabel[categoryHeader="Control"] {
    background-color: #4a3a1a;
}

QLabel[categoryHeader="I/O"] {
    background-color: #1a4a2e;
}

/* === Security Warning === */
QLabel[securityWarning="true"] {
    background-color: rgba(248, 113, 113, 0.15);
    color: #f87171;
    padding: 8px;
    border-radius: 4px;
    font-weight: bold;
}

/* === Code Editor === */
QPlainTextEdit[codeEditor="true"] {
    font-family: "SF Mono", "Menlo", "Consolas", "Monaco", "Courier New";
    font-size: 12px;
    background-color: #0a0e13;
    color: #e2e8f0;
    border: 1px solid #1e2530;
    border-radius: 4px;
}

/* === Runner View Elements === */
QWidget[runnerHeader="true"] {
    background-color: #0b0f14;
    border-radius: 8px;
}

QWidget[runnerControls="true"] {
    background-color: #0b0f14;
    border-radius: 12px;
}

/* === Runner Control Buttons === */
QPushButton[runnerAction="start"] {
    background-color: #34d399;
    color: #e2e8f0;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

QPushButton[runnerAction="start"]:pressed {
    background-color: #22a57a;
}

QPushButton[runnerAction="stop"] {
    background-color: #718096;
    color: #e2e8f0;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

QPushButton[runnerAction="stop"]:pressed {
    background-color: #5a6878;
}

QPushButton[runnerAction="emergency"] {
    background-color: rgba(248, 113, 113, 0.2);
    color: #f87171;
    font-size: 18px;
    font-weight: bold;
    border-radius: 12px;
    border: 2px solid #f87171;
}

QPushButton[runnerAction="emergency"]:pressed {
    background-color: rgba(248, 113, 113, 0.35);
}

/* === Runner Status (Larger) === */
QLabel[runnerStatus="true"] {
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: bold;
}

/* === Dynamic Property Selectors === */

/* Text roles */
QLabel[textRole="muted"] { color: #718096; font-size: 11px; }
QLabel[textRole="section"] { color: #718096; font-size: 10px; font-weight: bold; }
QLabel[textRole="secondary"] { color: #94a3b8; }
QLabel[textRole="disabled"] { color: #475569; }
QLabel[textRole="primary"] { color: #e2e8f0; }

/* Button roles */
QPushButton[buttonRole="secondary"] { background-color: #1e2530; color: #94a3b8; }
QPushButton[buttonRole="secondary"]:hover { background-color: #2a3440; }
QPushButton[buttonRole="secondary"]:pressed { background-color: #151c25; }
QPushButton[buttonRole="danger"] { background-color: rgba(248, 113, 113, 0.15); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); }
QPushButton[buttonRole="danger"]:hover { background-color: rgba(248, 113, 113, 0.25); }

/* Recording indicator */
QLabel[recording="true"] { background-color: rgba(248, 113, 113, 0.2); color: #f87171; padding: 2px 8px; border-radius: 8px; font-size: 11px; font-weight: bold; }

/* Input value display */
QLabel[inputValue="true"] { background-color: #151c25; border-radius: 4px; color: #34d399; padding: 4px 8px; }

/* Properties panel section headers */
QLabel[class="props-section-header"] {
    color: #718096;
    font-size: 10px;
    font-weight: bold;
    padding-top: 4px;
    padding-bottom: 2px;
}

/* Properties panel dividers */
QFrame[class="props-divider"] {
    color: #1e2530;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Device card */
QWidget[deviceCard="true"] { background-color: #0f1419; border: 2px solid #1e2530; border-radius: 12px; }

/* Status states */
QLabel[statusIndicator="true"] { color: #e2e8f0; padding: 4px 12px; border-radius: 4px; font-weight: bold; margin: 2px; }
QLabel[statusState="IDLE"] { background-color: #1e2530; }
QLabel[statusState="READY"] { background-color: rgba(52, 211, 153, 0.15); color: #34d399; }
QLabel[statusState="RUNNING"] { background-color: rgba(56, 189, 248, 0.15); color: #38bdf8; }
QLabel[statusState="PAUSED"], QLabel[statusState="STOPPING"] { background-color: rgba(251, 191, 36, 0.15); color: #fbbf24; }
QLabel[statusState="ERROR"] { background-color: rgba(248, 113, 113, 0.15); color: #f87171; }
QLabel[statusState="INITIALIZING"] { background-color: rgba(96, 165, 250, 0.15); color: #60a5fa; }

/* === Plugins window ===
 *
 * Every colour on a plugin row lives here rather than on the widget. A
 * widget-level stylesheet out-prioritises this file, so one stray
 * `setStyleSheet` in plugin_card.py would make that one label the only thing
 * on the row the theme cannot reach. The card and dialog therefore set nothing
 * but `objectName` and a dynamic `state` property.
 *
 * Property selectors are resolved at polish time, not when the property is
 * set, so `PluginCard.set_state` re-polishes the widgets it retags. Without
 * that these `[state="..."]` rules would never fire on a state change.
 *
 * Hex values are the tokens from glider/gui/styles/colors.py, named in the
 * comments -- QSS cannot import them. The semantic STATE_OK / STATE_WARN /
 * STATE_ERR family is held apart from the cyan ACCENT on purpose: the accent
 * marks the primary action, so painting "needs attention" in it too would put
 * the two in competition.
 */

QDialog#PluginManagerDialog {
    background-color: #0f1419;                      /* BASE */
}

/* -- toolbar: search field and the three filter chips -- */

QLineEdit#pluginSearch {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 7px;
    padding: 7px 11px;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
}

QLineEdit#pluginSearch:focus {
    border-color: #38bdf8;                          /* ACCENT */
}

/* A chip, not a button: rounded to half its height. QSS has no `999px`
 * shorthand, and a radius larger than half the box is clamped anyway. */
QPushButton#pluginFilter {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 13px;
    padding: 6px 14px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 12px;
    font-weight: 500;
}

QPushButton#pluginFilter:hover {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
}

QPushButton#pluginFilter:checked {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    border-color: rgba(56, 189, 248, 0.45);
    color: #38bdf8;                                 /* ACCENT */
}

/* -- the list -- */

QScrollArea#pluginScroll {
    background-color: transparent;
    border: none;
}

QLabel#pluginEmpty {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 13px;
    padding: 32px 0;
}

/* -- one row -- */

QFrame#PluginCard {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 9px;
}

QFrame#PluginCard:hover {
    background-color: #151c25;                      /* SURFACE_2 */
    border-color: #2a3440;
}

/* A row doing something, and a row that failed, are findable by scrolling
 * past them rather than by reading every pill. */
QFrame#PluginCard[state="installing"] {
    border-color: rgba(56, 189, 248, 0.35);         /* ACCENT */
}

QFrame#PluginCard[state="incompatible"] {
    border-color: rgba(251, 191, 36, 0.30);         /* STATE_WARN */
}

QFrame#PluginCard[state="failed"],
QFrame#PluginCard[state="broken"] {
    border-color: rgba(248, 113, 113, 0.35);        /* STATE_ERR */
}

/* Every label states its own background: the global `QWidget` rule at the top
 * of this file matches QLabel too, so an unset label paints a #0f1419 box on
 * the #111820 card. `QFrame#PluginCard QLabel { background: transparent }`
 * would be the shorter fix and the wrong one -- at specificity 102 it
 * out-ranks `QLabel#pluginStatePill` at 101 and would erase the pill tint. */

QLabel#pluginCardName {
    background-color: transparent;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 15px;
    font-weight: 600;
}

QLabel#pluginCardPackage {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
}

QLabel#pluginCardVersion {
    background-color: transparent;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
}

QLabel#pluginCardDescription {
    background-color: transparent;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 13px;
}

QLabel#pluginCardMeta {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 12px;
}

/* -- the state pill, all six states -- */

QLabel#pluginStatePill {
    background-color: rgba(113, 128, 150, 0.15);    /* TEXT_MUTED @ 15% */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 9px;
    padding: 2px 9px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 11px;
    font-weight: 600;
}

QLabel#pluginStatePill[state="enabled"] {
    background-color: rgba(74, 222, 128, 0.13);     /* STATE_OK @ 13% */
    border-color: rgba(74, 222, 128, 0.30);
    color: #4ade80;                                 /* STATE_OK */
}

/* Disabled and available share the neutral chip. Neither is a problem and
 * neither is running -- what separates them is the button beside them. */
QLabel#pluginStatePill[state="disabled"],
QLabel#pluginStatePill[state="available"] {
    background-color: rgba(113, 128, 150, 0.15);    /* TEXT_MUTED @ 15% */
    border-color: #1e2530;                          /* BORDER */
    color: #94a3b8;                                 /* TEXT_TERTIARY */
}

QLabel#pluginStatePill[state="installing"] {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    border-color: rgba(56, 189, 248, 0.35);
    color: #38bdf8;                                 /* ACCENT */
}

QLabel#pluginStatePill[state="incompatible"] {
    background-color: rgba(251, 191, 36, 0.13);     /* STATE_WARN @ 13% */
    border-color: rgba(251, 191, 36, 0.30);
    color: #fbbf24;                                 /* STATE_WARN */
}

/* An install that failed and a package that installed but will not import are
 * the same colour on purpose: both need a human, and the pill text and the
 * message underneath say which is which. */
QLabel#pluginStatePill[state="failed"],
QLabel#pluginStatePill[state="broken"] {
    background-color: rgba(248, 113, 113, 0.13);    /* STATE_ERR @ 13% */
    border-color: rgba(248, 113, 113, 0.30);
    color: #f87171;                                 /* STATE_ERR */
}

/* -- row actions --
 *
 * The file-wide default QPushButton is accent-filled, which would make Disable,
 * Reload, Enable and Cancel all shout as loudly as Install. Inside a card the
 * default is a quiet surface control and only [role="primary"] carries the
 * accent. */

QFrame#PluginCard QPushButton {
    background-color: #151c25;                      /* SURFACE_2 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 6px;
    padding: 6px 14px;
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
    font-weight: 500;
}

QFrame#PluginCard QPushButton:hover {
    background-color: #1e2530;                      /* BORDER */
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
}

QFrame#PluginCard QPushButton:pressed {
    background-color: #111820;                      /* SURFACE_1 */
}

QFrame#PluginCard QPushButton:disabled {
    background-color: #111820;                      /* SURFACE_1 */
    border-color: #1e2530;                          /* BORDER */
    color: #475569;                                 /* TEXT_DISABLED */
}

QFrame#PluginCard QPushButton[role="primary"] {
    background-color: #38bdf8;                      /* ACCENT */
    border-color: #38bdf8;
    color: #04222f;                                 /* dark ink on a light fill */
    font-weight: 600;
}

QFrame#PluginCard QPushButton[role="primary"]:hover {
    background-color: #0ea5e9;                      /* ACCENT_HOVER */
    border-color: #0ea5e9;
}

QFrame#PluginCard QPushButton[role="primary"]:pressed {
    background-color: #0284c7;                      /* ACCENT_PRESSED */
    border-color: #0284c7;
}

/* Incompatible keeps a visible Install so the reason underneath it has
 * something to point at, so the primary fill needs a disabled form. */
QFrame#PluginCard QPushButton[role="primary"]:disabled {
    background-color: #111820;                      /* SURFACE_1 */
    border-color: #1e2530;                          /* BORDER */
    color: #475569;                                 /* TEXT_DISABLED */
}

/* -- progress, inline message, pip transcript -- */

/* Indeterminate: pip reports no total, so the bar is a heartbeat, not a
 * measurement. Kept to a hairline so it does not read as a quantity. */
QProgressBar#pluginCardProgress {
    background-color: #151c25;                      /* SURFACE_2 */
    border: none;
    border-radius: 2px;
}

QProgressBar#pluginCardProgress::chunk {
    background-color: #38bdf8;                      /* ACCENT */
    border-radius: 2px;
}

QLabel#pluginCardMessage {
    background-color: transparent;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 12px;
}

QLabel#pluginCardMessage[state="installing"] {
    color: #38bdf8;                                 /* ACCENT */
}

QLabel#pluginCardMessage[state="incompatible"] {
    color: #fbbf24;                                 /* STATE_WARN */
}

QLabel#pluginCardMessage[state="failed"],
QLabel#pluginCardMessage[state="broken"] {
    color: #f87171;                                 /* STATE_ERR */
}

/* Recessed below the card surface: pip output is evidence, not chrome. */
QPlainTextEdit#pluginCardOutput {
    background-color: #0a0e13;                      /* CANVAS */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 6px;
    padding: 8px 10px;
    color: #718096;                                 /* TEXT_MUTED */
    selection-background-color: #38bdf8;            /* ACCENT */
}

/* Read-only. The file-wide cyan focus ring would promise an edit that the
 * transcript will not accept. */
QPlainTextEdit#pluginCardOutput:focus {
    border-color: #1e2530;                          /* BORDER */
}

/* -- footer: which index won, and how old it is -- */

QLabel#pluginFooter {
    background-color: transparent;
    border-top: 1px solid #1e2530;                  /* BORDER */
    padding-top: 10px;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 12px;
}

/* === Builder shell: side panels ===
 *
 * Every colour on a side panel lives here rather than on the widget, for the
 * same reason as the plugin rows above: a widget-level stylesheet
 * out-prioritises this file, so one `setStyleSheet` in side_panel.py would
 * make that widget the only part of the shell the theme cannot reach.
 * `side_panel.py` sets nothing but `objectName` and two dynamic properties.
 *
 * `state` is "expanded" or "collapsed"; `side` is "left" or "right" and only
 * decides which edge carries the divider, so the rail always sits against the
 * window edge and the content always sits against the centre surface.
 *
 * Property selectors resolve at polish time, so `SidePanel.set_expanded`
 * re-polishes itself after retagging. Without that these rules never fire.
 *
 * Hex values are the tokens from glider/gui/styles/colors.py, named in the
 * comments -- QSS cannot import them.
 */

QFrame#sidePanel {
    background-color: #0f1419;                      /* BASE */
}

/* The rail is the collapsed panel: 34 px of icons rather than nothing, so the
 * areas stay discoverable for a first-time user. Recessed to chrome depth so
 * it reads as an edge rather than as a second panel. */
QFrame#sidePanelRail {
    background-color: #0b0f14;                      /* CHROME */
}

QFrame#sidePanel[side="left"] QFrame#sidePanelRail {
    border-right: 1px solid #1e2530;                /* BORDER */
}

QFrame#sidePanel[side="right"] QFrame#sidePanelRail {
    border-left: 1px solid #1e2530;                 /* BORDER */
}

QToolButton#sidePanelRailButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 13px;
    font-weight: 600;
}

QToolButton#sidePanelRailButton:hover {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
}

QToolButton#sidePanelRailButton:checked {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    color: #38bdf8;                                 /* ACCENT */
}

/* -- expanded: tab strip over the content -- */

QFrame#sidePanelBody {
    background-color: #0f1419;                      /* BASE */
}

QFrame#sidePanel[side="left"] QFrame#sidePanelBody {
    border-right: 1px solid #1e2530;                /* BORDER */
}

QFrame#sidePanel[side="right"] QFrame#sidePanelBody {
    border-left: 1px solid #1e2530;                 /* BORDER */
}

QFrame#sidePanelTabs {
    background-color: transparent;
    border-bottom: 1px solid #1e2530;               /* BORDER */
}

/* No dock title bar, no close button: the tab strip is the whole header. */
QToolButton#sidePanelTab {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 12px;
    font-weight: 500;
}

QToolButton#sidePanelTab:hover {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
}

QToolButton#sidePanelTab:checked {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    color: #38bdf8;                                 /* ACCENT */
}

QStackedWidget#sidePanelStack {
    background-color: #0f1419;                      /* BASE */
    border: none;
}

/* === Builder shell: the status strip ===
 *
 * The one piece of chrome that cannot be summoned, so it is the one place the
 * theme has to get right without anyone opening a panel to check. As with the
 * side panels above, every colour lives here and `status_strip.py` sets nothing
 * but `objectName` and a dynamic `state` property; a widget-level stylesheet
 * would out-prioritise this file and make that widget unthemeable.
 *
 * `state` is the run state on the pill (idle/running/recording/error) and the
 * device state on a dot and its chip (ok/warn/error/unknown). Selectors resolve
 * at polish time, so `set_run_state` and `set_devices` re-polish after
 * retagging -- without that these rules never fire.
 *
 * Hex values are the tokens from glider/gui/styles/colors.py, named in the
 * comments -- QSS cannot import them.
 */

QFrame#statusStrip {
    background-color: #0b0f14;                      /* CHROME */
    border-bottom: 1px solid #1e2530;               /* BORDER */
}

QFrame#statusStripToggles,
QFrame#statusStripDevices {
    background-color: transparent;
}

/* -- panel toggles -- */

QToolButton#statusStripToggle {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 5px;
    min-width: 24px;
    max-width: 24px;
    min-height: 22px;
    max-height: 22px;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 11px;
}

QToolButton#statusStripToggle:hover {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
}

/* Checked means "that panel is open". It echoes the panel rather than owning
 * it, which is why status_strip.py sets it with signals blocked. */
QToolButton#statusStripToggle:checked {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    border-color: rgba(56, 189, 248, 0.40);
    color: #38bdf8;                                 /* ACCENT */
}

/* -- experiment name and its dirty marker -- */

QLabel#statusStripExperiment {
    background-color: transparent;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 13px;
    font-weight: 600;
}

/* Quieter than the name on purpose: "edited" is a fact about the file, not a
 * problem, and the strip has louder things to say. */
QLabel#statusStripDirty {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 13px;
    font-weight: 400;
}

/* -- the run-state pill --
 *
 * Recording is red because record-red is near-universal, and `error` therefore
 * cannot also be a red tint or the two would be indistinguishable in the one
 * state that matters. Error is the only *filled* thing on the strip: nothing
 * else can out-shout it, which is the whole point of it.
 */

QLabel#statusStripPill {
    background-color: rgba(113, 128, 150, 0.15);    /* TEXT_MUTED @ 15% */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 9px;
    padding: 2px 9px;
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
    font-size: 11px;
    font-weight: 600;
}

QLabel#statusStripPill[state="idle"] {
    background-color: rgba(113, 128, 150, 0.15);    /* TEXT_MUTED @ 15% */
    border-color: #1e2530;                          /* BORDER */
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
}

QLabel#statusStripPill[state="running"] {
    background-color: rgba(74, 222, 128, 0.13);     /* STATE_OK @ 13% */
    border-color: rgba(74, 222, 128, 0.30);
    color: #4ade80;                                 /* STATE_OK */
}

QLabel#statusStripPill[state="recording"] {
    background-color: rgba(248, 113, 113, 0.13);    /* STATE_ERR @ 13% */
    border-color: rgba(248, 113, 113, 0.32);
    color: #f87171;                                 /* STATE_ERR */
}

QLabel#statusStripPill[state="error"] {
    background-color: #f87171;                      /* STATE_ERR */
    border-color: #f87171;
    color: #2a0a0a;                                 /* dark ink on a light fill */
}

/* -- devices --
 *
 * A healthy device is a quiet dot with a name. A down one becomes a tinted chip
 * whose name is red too, so it differs from the devices *beside* it and not
 * only from itself a moment ago -- nobody was watching a moment ago. That is
 * the mockup's third state: a device down while the pill says Recording.
 */

QFrame#statusStripDevice {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 1px 2px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 12px;
}

QFrame#statusStripDevice[state="error"] {
    background-color: rgba(248, 113, 113, 0.13);    /* STATE_ERR @ 13% */
    border-color: rgba(248, 113, 113, 0.30);
    padding: 1px 7px;
    color: #f87171;                                 /* STATE_ERR */
}

QFrame#statusStripDevice[state="unknown"] {
    color: #718096;                                 /* TEXT_MUTED */
}

/* No colour of its own: it inherits the chip's, so a red chip has a red name
 * without a second rule to keep in step. */
QLabel#statusStripDeviceName {
    background-color: transparent;
    font-size: 12px;
}

/* The dot's `color` is set alongside its fill so the resolved state is legible
 * to a test without screenshotting the widget. */
QLabel#statusStripDot {
    background-color: #718096;                      /* TEXT_MUTED */
    color: #718096;
    border-radius: 4px;                             /* half of the 8 px side */
}

QLabel#statusStripDot[state="ok"] {
    background-color: #4ade80;                      /* STATE_OK */
    color: #4ade80;
}

QLabel#statusStripDot[state="warn"] {
    background-color: #fbbf24;                      /* STATE_WARN */
    color: #fbbf24;
}

QLabel#statusStripDot[state="error"] {
    background-color: #f87171;                      /* STATE_ERR */
    color: #f87171;
}

QLabel#statusStripDot[state="unknown"] {
    background-color: #475569;                      /* TEXT_DISABLED */
    color: #475569;
}

/* -- the palette hint --
 *
 * Styled as a key cap, and pressable: a hint that teaches a shortcut and then
 * refuses to perform it is worse than no hint.
 */

QToolButton#statusStripPaletteHint {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 4px;
    padding: 2px 6px;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 11px;
}

QToolButton#statusStripPaletteHint:hover {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #c0c8d4;                                 /* TEXT_SECONDARY */
}

/* === Builder shell: the command palette ===
 *
 * `Ctrl+K` puts this over the window. After Task 6 removes four menus it is
 * the Builder's primary navigation, read by someone who has never seen it, so
 * two rules here carry meaning rather than decoration:
 *
 *   - `[state="disabled"]` greys a row; it does not hide it. The palette has to
 *     answer "can I do this yet?" as well as "where is it?", and a row that
 *     vanishes when unavailable answers neither.
 *   - The category and the shortcut are dimmer than the command name, so the
 *     eye lands on the name first and the two supporting facts stay legible
 *     rather than competing with it.
 *
 * `command_palette.py` sets nothing but `objectName` and the `state` property;
 * every colour is here. Property selectors resolve at polish time, so the row
 * builder re-polishes after tagging -- without that the disabled rule never
 * fires and every row looks available.
 *
 * Hex values are the tokens from glider/gui/styles/colors.py, named in the
 * comments -- QSS cannot import them.
 */

/* The scrim. Dark enough to push the Builder back, translucent enough that the
 * user can still see what they are about to act on. */
QFrame#commandPalette {
    background-color: rgba(10, 14, 19, 0.72);       /* CANVAS at 72% */
}

QFrame#commandPaletteCard {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 8px;
}

QLineEdit#commandPaletteSearch {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #1e2530;               /* BORDER */
    border-radius: 0;
    padding: 10px 12px;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 14px;
}

QListWidget#commandPaletteList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

QListWidget#commandPaletteList::item {
    border-radius: 4px;
}

QListWidget#commandPaletteList::item:selected {
    background-color: #151c25;                      /* SURFACE_2 */
}

QFrame#commandPaletteRow {
    background-color: transparent;
}

QLabel#commandPaletteRowText {
    background-color: transparent;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 13px;
}

QLabel#commandPaletteRowCategory {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 11px;
}

QLabel#commandPaletteRowShortcut {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 11px;
}

/* Greyed, never hidden: "not available yet" is a different statement from
 * "this app cannot do that", and only one of them is true. */
QFrame#commandPaletteRow[state="disabled"] QLabel#commandPaletteRowText,
QFrame#commandPaletteRow[state="disabled"] QLabel#commandPaletteRowCategory,
QFrame#commandPaletteRow[state="disabled"] QLabel#commandPaletteRowShortcut {
    color: #475569;                                 /* TEXT_DISABLED */
}

/* Shown instead of the list, never beside it. A blank box is indistinguishable
 * from a broken one, and the runner window reaches this state honestly: it has
 * no menu bar to source commands from. */
QLabel#commandPaletteEmpty {
    background-color: transparent;
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 13px;
    padding: 24px 12px;
}
