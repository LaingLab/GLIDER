/*
 * GLIDER Touch Stylesheet — Deep Navy palette
 * High-contrast theme for Raspberry Pi 480x800 touchscreen
 * Optimized for touch with large targets (min 80px)
 *
 * Color tokens:
 *   BASE        #0f1419
 *   CHROME      #0b0f14
 *   CANVAS      #0a0e13
 *   BORDER      #1e2530
 *   ACCENT      #38bdf8
 *   ACCENT_HOVER #0ea5e9
 *   TEXT_PRIMARY #e2e8f0
 *   TEXT_MUTED   #718096
 *   TEXT_DISABLED #475569
 */

/* === Global === */
QWidget {
    background-color: #0a0e13;
    color: #e2e8f0;
    font-family: -apple-system, BlinkMacSystemFont, "Roboto", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

/* === Main Window === */
QMainWindow {
    background-color: #0a0e13;
}

/* === Status Bar === */
QStatusBar {
    background-color: #0b0f14;
    border-top: 2px solid #1e2530;
    min-height: 40px;
    font-size: 14px;
}

/* === Scroll Area === */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #0b0f14;
    width: 20px;
    border-radius: 10px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background-color: #1e2530;
    border-radius: 8px;
    min-height: 60px;
}

QScrollBar::handle:vertical:pressed {
    background-color: #0ea5e9;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0b0f14;
    height: 20px;
    border-radius: 10px;
    margin: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #1e2530;
    border-radius: 8px;
    min-width: 60px;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #0ea5e9;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Push Button === */
QPushButton {
    background-color: #38bdf8;
    color: #e2e8f0;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
    min-height: 44px;
}

QPushButton:pressed {
    background-color: #0ea5e9;
}

QPushButton:disabled {
    background-color: #1e2530;
    /* Muted but still legible (was #475569, ~1.9:1) so a disconnected control's
       label can be read by a gloved operator. */
    color: #718096;
}

/* Runner Manual status strip: persistent icon+text notice. Level is set as a
   dynamic property; each variant pairs a distinct tint with a text glyph so it
   never relies on color alone. */
QLabel#runnerStatusStrip {
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    color: #e2e8f0;
    background-color: #1e2530;
}
QLabel#runnerStatusStrip[level="error"] {
    background-color: rgba(248, 113, 113, 0.20);
    color: #f87171;
}
QLabel#runnerStatusStrip[level="warn"] {
    background-color: rgba(251, 191, 36, 0.20);
    color: #fbbf24;
}
QLabel#runnerStatusStrip[level="info"] {
    background-color: rgba(96, 165, 250, 0.18);
    color: #93c5fd;
}

/* Primary action button */
QPushButton[primary="true"] {
    background-color: #34d399;
}

QPushButton[primary="true"]:pressed {
    background-color: #22a57a;
}

/* Danger button */
QPushButton[danger="true"] {
    background-color: rgba(248, 113, 113, 0.2);
    color: #f87171;
    border: 2px solid #f87171;
}

QPushButton[danger="true"]:pressed {
    background-color: rgba(248, 113, 113, 0.35);
}

/* Secondary button */
QPushButton[secondary="true"] {
    background-color: #1e2530;
    color: #94a3b8;
}

QPushButton[secondary="true"]:pressed {
    background-color: #2a3440;
}

/* === Label === */
QLabel {
    background-color: transparent;
    color: #e2e8f0;
}

QLabel[title="true"] {
    font-size: 18px;
    font-weight: bold;
}

QLabel[subtitle="true"] {
    font-size: 14px;
    color: #94a3b8;
}

QLabel[value="true"] {
    font-size: 22px;
    font-weight: bold;
    color: #38bdf8;
}

QLabel[muted="true"] {
    font-size: 14px;
    color: #718096;
}

/* === Slider === */
QSlider {
    min-height: 60px;
}

QSlider::groove:horizontal {
    height: 24px;
    background-color: #1e2530;
    border-radius: 12px;
}

QSlider::handle:horizontal {
    width: 48px;
    height: 48px;
    margin: -12px 0;
    background-color: #38bdf8;
    border-radius: 24px;
    border: 4px solid #0ea5e9;
}

QSlider::handle:horizontal:pressed {
    background-color: #0ea5e9;
    border-color: #0284c7;
}

QSlider::sub-page:horizontal {
    background-color: #38bdf8;
    border-radius: 12px;
}

QSlider::groove:vertical {
    width: 24px;
    background-color: #1e2530;
    border-radius: 12px;
}

QSlider::handle:vertical {
    width: 48px;
    height: 48px;
    margin: 0 -12px;
    background-color: #38bdf8;
    border-radius: 24px;
    border: 4px solid #0ea5e9;
}

/* === Spin Box === */
QSpinBox,
QDoubleSpinBox {
    background-color: #0f1419;
    border: 2px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    font-size: 16px;
    min-height: 40px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #38bdf8;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    background-color: #34d399;
    width: 50px;
    border-top-right-radius: 6px;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed {
    background-color: #22a57a;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: rgba(248, 113, 113, 0.4);
    width: 50px;
    border-bottom-right-radius: 6px;
}

QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: rgba(248, 113, 113, 0.6);
}

/* === Line Edit === */
QLineEdit {
    background-color: #0f1419;
    border: 2px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
    min-height: 36px;
    selection-background-color: #38bdf8;
}

QLineEdit:focus {
    border-color: #38bdf8;
}

/* === Combo Box === */
QComboBox {
    background-color: #0f1419;
    border: 2px solid #1e2530;
    border-radius: 6px;
    padding: 8px;
    font-size: 14px;
    min-height: 40px;
}

QComboBox:focus {
    border-color: #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 48px;
}

QComboBox QAbstractItemView {
    background-color: #0f1419;
    border: 2px solid #38bdf8;
    border-radius: 8px;
    selection-background-color: #38bdf8;
}

QComboBox QAbstractItemView::item {
    min-height: 50px;
    padding: 12px;
}

/* === Check Box === */
QCheckBox {
    spacing: 16px;
    min-height: 60px;
}

QCheckBox::indicator {
    width: 36px;
    height: 36px;
    border: 3px solid #1e2530;
    border-radius: 8px;
    background-color: #0f1419;
}

QCheckBox::indicator:checked {
    background-color: #38bdf8;
    border-color: #38bdf8;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #1e2530;
    border: none;
    border-radius: 12px;
    height: 24px;
    text-align: center;
    font-size: 14px;
}

QProgressBar::chunk {
    background-color: #38bdf8;
    border-radius: 12px;
}

/* === Frame === */
QFrame[class="card"] {
    background-color: #0f1419;
    border: 2px solid #1e2530;
    border-radius: 16px;
    padding: 16px;
}

QFrame[class="separator"] {
    background-color: #1e2530;
    max-height: 2px;
}

/* === Group Box === */
QGroupBox {
    border: 2px solid #1e2530;
    border-radius: 12px;
    margin-top: 20px;
    padding: 16px;
    padding-top: 24px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 16px;
    font-size: 16px;
    font-weight: bold;
    color: #94a3b8;
}

/* === List Widget === */
QListWidget {
    background-color: #0f1419;
    border: 2px solid #1e2530;
    border-radius: 8px;
}

QListWidget::item {
    padding: 16px;
    border-bottom: 1px solid #1e2530;
    min-height: 50px;
}

QListWidget::item:selected {
    background-color: #38bdf8;
}

QListWidget::item:hover {
    background-color: #1e2530;
}

/* === Tab Widget === */
QTabWidget::pane {
    border: 2px solid #1e2530;
    border-radius: 8px;
    background-color: #0f1419;
}

QTabBar::tab {
    background-color: #0b0f14;
    color: #718096;
    padding: 8px 12px;
    font-size: 12px;
    min-width: 60px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #0f1419;
    color: #e2e8f0;
    border-bottom: 3px solid #38bdf8;
}

/* === Dock Widget Tab Bar (compact for Pi screen) === */
QMainWindow::separator {
    background-color: #1e2530;
    width: 4px;
    height: 4px;
}

QTabBar[tabPosition="South"]::tab,
QTabBar[tabPosition="North"]::tab {
    padding: 6px 10px;
    font-size: 11px;
    min-width: 50px;
    max-width: 80px;
}

/* === Tool Tip === */
QToolTip {
    background-color: #1e2530;
    color: #e2e8f0;
    border: 2px solid #38bdf8;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
}

/* === Message Box === */
QMessageBox {
    background-color: #0f1419;
}

QMessageBox QLabel {
    font-size: 18px;
    min-height: 60px;
}

QMessageBox QPushButton {
    min-width: 120px;
}

/* === Dialog === */
QDialog {
    background-color: #0f1419;
}

/* === Header Bar (Runner) === */
.HeaderBar {
    background-color: #0b0f14;
    border-bottom: 2px solid #1e2530;
    min-height: 60px;
}

/* === Dashboard Widget Container === */
.DashboardWidget {
    background-color: #0f1419;
    border: 2px solid #1e2530;
    border-radius: 16px;
    margin: 8px;
    padding: 16px;
}

.DashboardWidget:hover {
    border-color: #2a3440;
}

/* === Control Panel === */
.ControlPanel {
    background-color: #0b0f14;
    border-top: 2px solid #1e2530;
    min-height: 80px;
}

.ControlPanel QPushButton {
    min-width: 100px;
    min-height: 70px;
}

/* Start button */
.ControlPanel QPushButton[action="start"] {
    background-color: #34d399;
}

.ControlPanel QPushButton[action="start"]:pressed {
    background-color: #22a57a;
}

/* Stop button */
.ControlPanel QPushButton[action="stop"] {
    background-color: #718096;
}

.ControlPanel QPushButton[action="stop"]:pressed {
    background-color: #5a6878;
}

/* Pause button */
.ControlPanel QPushButton[action="pause"] {
    background-color: #fbbf24;
}

.ControlPanel QPushButton[action="pause"]:pressed {
    background-color: #d69e10;
}

/* === Status Indicators === */
.StatusIndicator {
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
}

.StatusIndicator[status="running"] {
    background-color: rgba(52, 211, 153, 0.15);
    color: #34d399;
}

.StatusIndicator[status="stopped"] {
    background-color: #1e2530;
    color: #718096;
}

.StatusIndicator[status="paused"] {
    background-color: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
}

.StatusIndicator[status="error"] {
    background-color: rgba(248, 113, 113, 0.15);
    color: #f87171;
}

/* === Keyboard (Virtual) === */
.VirtualKeyboard {
    background-color: #0b0f14;
    border-top: 2px solid #1e2530;
}

.VirtualKeyboard QPushButton {
    min-height: 60px;
    min-width: 50px;
    font-size: 20px;
    margin: 2px;
}

/* === Runner Status Colors === */
QLabel[runnerStatus="true"] {
    padding: 6px 14px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: bold;
    color: #e2e8f0;
}

QLabel[statusState="IDLE"] {
    background-color: #1e2530;
}

QLabel[statusState="READY"] {
    background-color: rgba(52, 211, 153, 0.15);
    color: #34d399;
}

QLabel[statusState="RUNNING"] {
    background-color: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
}

QLabel[statusState="PAUSED"],
QLabel[statusState="STOPPING"] {
    background-color: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
}

QLabel[statusState="ERROR"] {
    background-color: rgba(248, 113, 113, 0.15);
    color: #f87171;
}

QLabel[statusState="INITIALIZING"] {
    background-color: rgba(167, 139, 250, 0.15);
    color: #a78bfa;
}

/* === Recording Indicator === */
QLabel[recording="true"] {
    background-color: rgba(248, 113, 113, 0.2);
    color: #f87171;
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: bold;
}

/* === Runner Control Buttons === */
QPushButton[runnerAction="start"] {
    background-color: #34d399;
    color: #e2e8f0;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

QPushButton[runnerAction="start"]:pressed {
    background-color: #22a57a;
}

QPushButton[runnerAction="stop"] {
    background-color: #718096;
    color: #e2e8f0;
    font-size: 20px;
    font-weight: bold;
    border-radius: 12px;
    border: none;
}

QPushButton[runnerAction="stop"]:pressed {
    background-color: #5a6878;
}

QPushButton[runnerAction="emergency"] {
    background-color: rgba(248, 113, 113, 0.2);
    color: #f87171;
    font-size: 18px;
    font-weight: bold;
    border-radius: 12px;
    border: 2px solid #f87171;
}

QPushButton[runnerAction="emergency"]:pressed {
    background-color: rgba(248, 113, 113, 0.35);
}

/* === Runner View === */
QWidget[runnerHeader="true"] {
    background-color: #0b0f14;
    border-radius: 8px;
}

/* === Persistent Run Banner (shown across Runner pages during a live run) === */
QWidget[runnerRunBanner="true"] {
    background-color: #0b0f14;
    border-top: 1px solid #1e2530;
    border-bottom: 1px solid #1e2530;
}

QWidget[runnerRunBanner="true"] QLabel[timer="true"] {
    color: #34d399;
}

/* === Readiness Strip (Dashboard) === */
QWidget[readinessStrip="true"] {
    background-color: transparent;
}

/* Blocked gate: tall, amber, tappable — the row demands attention. */
QPushButton[readinessRow="blocked"] {
    background-color: #fbbf24;
    color: #1a1400;
    font-size: 15px;
    font-weight: bold;
    min-height: 60px;
    border-radius: 10px;
    border: none;
    text-align: left;
    padding-left: 16px;
}

QPushButton[readinessRow="blocked"]:pressed {
    background-color: #e0a91a;
}

/* Satisfied gate: slim green confirmation — no longer needs a tap. */
QPushButton[readinessRow="ok"] {
    background-color: rgba(52, 211, 153, 0.12);
    color: #34d399;
    font-size: 13px;
    font-weight: bold;
    min-height: 32px;
    max-height: 32px;
    border-radius: 8px;
    border: 1px solid rgba(52, 211, 153, 0.3);
    text-align: left;
    padding-left: 16px;
}

QPushButton[readinessRow="ok"]:pressed {
    background-color: rgba(52, 211, 153, 0.2);
}

QWidget[runnerControls="true"] {
    background-color: #0b0f14;
    border-radius: 12px;
}

/* === Dynamic Property Selectors (touch sizes: +2px from desktop) === */

/* Text roles */
QLabel[textRole="muted"] { color: #718096; font-size: 13px; }
QLabel[textRole="section"] { color: #718096; font-size: 12px; font-weight: bold; }
QLabel[textRole="secondary"] { color: #94a3b8; }
QLabel[textRole="disabled"] { color: #475569; }
QLabel[textRole="primary"] { color: #e2e8f0; }

/* Button roles */
QPushButton[buttonRole="secondary"] { background-color: #1e2530; color: #94a3b8; }
QPushButton[buttonRole="secondary"]:hover { background-color: #2a3440; }
QPushButton[buttonRole="danger"] { background-color: rgba(248, 113, 113, 0.15); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.3); }

/* Input value display */
QLabel[inputValue="true"] { background-color: #151c25; border-radius: 4px; color: #34d399; padding: 4px 8px; }

/* Properties panel section headers */
QLabel[class="props-section-header"] {
    color: #718096;
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
    padding-bottom: 2px;
}

/* Properties panel dividers */
QFrame[class="props-divider"] {
    color: #1e2530;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Device card */
QWidget[deviceCard="true"] { background-color: #0f1419; border: 2px solid #1e2530; border-radius: 12px; }

/* Status indicator (dynamic property version) */
QLabel[statusIndicator="true"] { color: #e2e8f0; padding: 4px 12px; border-radius: 4px; font-weight: bold; margin: 2px; }

/* Drag-and-drop target: the camera panel accepts pose models, behavior
   models and videos, routed by type. The accent border is the only
   feedback that a drop will land somewhere. */
CameraPanel[dropActive="true"] {
    border: 2px dashed #38bdf8;
}
