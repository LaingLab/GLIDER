/*
 * GLIDER Touch Stylesheet -- Deep Navy palette, Raspberry Pi 480x800 portrait.
 *
 * One quiet visual language: neutral surfaces, cyan only for the selected or
 * primary thing, green for START and red for STOP / REC. Every tap target is
 * at least 44 px. In this sheet a widget's min-height is its *content* height,
 * so a 1 px-bordered control asks for 42 px to land on 44.
 *
 * Colour tokens (glider/gui/styles/colors.py; QSS cannot import them):
 *   CANVAS        #0a0e13     BORDER         #1e2530
 *   CHROME        #0b0f14     TEXT_PRIMARY   #e2e8f0
 *   BASE          #0f1419     TEXT_TERTIARY  #94a3b8
 *   SURFACE_1     #111820     TEXT_MUTED     #718096
 *   SURFACE_2     #151c25     ACCENT         #38bdf8
 *   SUCCESS       #34d399     WARNING        #fbbf24
 *   ERROR         #f87171
 */

/* === Global === */
QWidget {
    background-color: #0f1419;                      /* BASE */
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-family: -apple-system, BlinkMacSystemFont, "Roboto", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 14px;
}

QMainWindow,
QDialog,
QMessageBox {
    background-color: #0f1419;                      /* BASE */
}

QLabel {
    background-color: transparent;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
}

/* === Scrolling === */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 20px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background-color: #1e2530;                      /* BORDER */
    border-radius: 6px;  /* geometric: half of the 12 px handle */
    min-height: 60px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 20px;
    margin: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #1e2530;                      /* BORDER */
    border-radius: 6px;  /* geometric: half of the 12 px handle */
    min-width: 60px;
}

QScrollBar::handle:pressed {
    background-color: #718096;                      /* TEXT_MUTED */
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: none;
}

/* === Push buttons ===
 * Neutral by default. A solid fill means something: cyan for the one primary
 * action on a screen, green START, red STOP.
 */
QPushButton {
    background-color: #151c25;                      /* SURFACE_2 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_MEDIUM@;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 14px;
    font-weight: 600;
    padding: 0 16px;
    min-height: 42px;
}

QPushButton:pressed {
    background-color: #111820;                      /* SURFACE_1 */
    border-color: rgba(56, 189, 248, 0.50);
}

QPushButton:checked {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    border-color: rgba(56, 189, 248, 0.50);
    color: #38bdf8;                                 /* ACCENT */
}

QPushButton:disabled {
    background-color: #111820;                      /* SURFACE_1 */
    border-color: #1e2530;
    color: #718096;                                 /* TEXT_MUTED: still legible */
}

QPushButton[primary="true"] {
    background-color: #38bdf8;                      /* ACCENT */
    border-color: #38bdf8;
    color: #0a0e13;                                 /* CANVAS: dark ink on cyan */
}

QPushButton[primary="true"]:pressed {
    background-color: rgba(56, 189, 248, 0.80);
}

QPushButton[secondary="true"],
QPushButton[buttonRole="secondary"] {
    background-color: transparent;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
}

QPushButton[secondary="true"]:pressed,
QPushButton[buttonRole="secondary"]:pressed {
    background-color: #111820;                      /* SURFACE_1 */
}

/* === Run controls (RunControlPanel) === */
QPushButton[runnerAction="start"],
QPushButton[runnerAction="stop"],
QPushButton[runnerAction="pause"] {
    border-radius: @RADIUS_LARGE@;
    font-size: 20px;
    font-weight: bold;
}

QPushButton[runnerAction="start"] {
    background-color: #34d399;                      /* SUCCESS */
    border-color: #34d399;
    color: #0a0e13;                                 /* CANVAS */
}

QPushButton[runnerAction="start"]:pressed {
    background-color: rgba(52, 211, 153, 0.80);
}

QPushButton[runnerAction="stop"] {
    background-color: #f87171;                      /* ERROR */
    border-color: #f87171;
    color: #0a0e13;                                 /* CANVAS */
}

QPushButton[runnerAction="stop"]:pressed {
    background-color: rgba(248, 113, 113, 0.80);
}

QPushButton[runnerAction="start"]:disabled,
QPushButton[runnerAction="stop"]:disabled {
    background-color: #151c25;                      /* SURFACE_2 */
    border-color: #1e2530;
    color: #718096;                                 /* TEXT_MUTED */
}

/* The Pi's run bar: a card at the foot of the Run page. */
QWidget#runControlPanel {
    background-color: #0b0f14;                      /* CHROME */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_LARGE@;
}

/* === Text inputs === */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_MEDIUM@;
    color: #e2e8f0;
    font-size: 14px;
    padding: 0 12px;
    min-height: 42px;
    selection-background-color: rgba(56, 189, 248, 0.35);
}

QTextEdit,
QPlainTextEdit {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_MEDIUM@;
    color: #e2e8f0;
    font-size: 14px;
    padding: 6px 8px;
    selection-background-color: rgba(56, 189, 248, 0.35);
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #38bdf8;                          /* ACCENT */
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color: #718096;                                 /* TEXT_MUTED */
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    border: none;
    width: 40px;
}

QComboBox::down-arrow {
    image: url(@ICONS@/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:disabled {
    image: url(@ICONS@/chevron-down-disabled.svg);
}

QComboBox QAbstractItemView {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_MEDIUM@;
    outline: none;
    selection-background-color: rgba(56, 189, 248, 0.13);
    selection-color: #38bdf8;
}

QComboBox QAbstractItemView::item {
    min-height: 44px;
    padding: 0 12px;
}

/* Spin boxes put a finger-sized − and + either side of the value, rather than
 * two half-height arrows stacked on the right. */
QSpinBox,
QDoubleSpinBox {
    padding: 0 4px;
    min-width: 150px;
    max-width: 150px;
    qproperty-alignment: AlignCenter;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    background-color: #151c25;                      /* SURFACE_2 */
    border: none;
    width: 44px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: center right;
    border-left: 1px solid #1e2530;
    border-top-right-radius: @RADIUS_MEDIUM@;
    border-bottom-right-radius: @RADIUS_MEDIUM@;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: center left;
    border-right: 1px solid #1e2530;
    border-top-left-radius: @RADIUS_MEDIUM@;
    border-bottom-left-radius: @RADIUS_MEDIUM@;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #1e2530;                      /* BORDER */
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(@ICONS@/plus.svg);
    width: 14px;
    height: 14px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(@ICONS@/minus.svg);
    width: 14px;
    height: 14px;
}

/* === Check box === */
QCheckBox,
QRadioButton {
    background-color: transparent;
    spacing: 12px;
    min-height: 44px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 1px solid #718096;                      /* TEXT_MUTED */
    background-color: #111820;                      /* SURFACE_1 */
}

QCheckBox::indicator {
    border-radius: @RADIUS_SMALL@;
}

QRadioButton::indicator {
    border-radius: 12px;  /* geometric: a circle, 22 px + 1 px border */
}

QCheckBox::indicator:checked {
    background-color: #38bdf8;                      /* ACCENT */
    border-color: #38bdf8;
    image: url(@ICONS@/check.svg);
}

QRadioButton::indicator:checked {
    border-color: #38bdf8;                          /* ACCENT: a dot in a ring */
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #38bdf8, stop: 0.45 #38bdf8, stop: 0.5 #111820, stop: 1 #111820);
}

/* === Slider: a 44 px knob on a slim track === */
QSlider {
    background-color: transparent;
    min-height: 44px;
}

QSlider::groove:horizontal {
    height: 8px;
    background-color: #1e2530;                      /* BORDER */
    border-radius: 4px;  /* geometric */
}

QSlider::sub-page:horizontal {
    background-color: #38bdf8;                      /* ACCENT */
    border-radius: 4px;  /* geometric */
}

QSlider::handle:horizontal {
    width: 40px;
    height: 40px;
    margin: -18px 0;
    background-color: #e2e8f0;                      /* TEXT_PRIMARY */
    border: 2px solid #38bdf8;                      /* ACCENT */
    border-radius: 22px;  /* geometric */
}

QSlider::groove:vertical {
    width: 8px;
    background-color: #1e2530;
    border-radius: 4px;  /* geometric */
}

QSlider::handle:vertical {
    width: 40px;
    height: 40px;
    margin: 0 -18px;
    background-color: #e2e8f0;
    border: 2px solid #38bdf8;
    border-radius: 22px;  /* geometric */
}

QSlider::handle:pressed {
    background-color: #38bdf8;                      /* ACCENT */
}

/* === Progress bar === */
QProgressBar {
    background-color: #1e2530;                      /* BORDER */
    border: none;
    border-radius: 12px;  /* geometric */
    height: 24px;
    text-align: center;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: #38bdf8;                      /* ACCENT */
    border-radius: 12px;  /* geometric */
}

/* === Separator lines === */
QFrame[frameShape="4"] { /* HLine */
    background-color: #1e2530;                      /* BORDER */
    border: none;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    background-color: #1e2530;                      /* BORDER */
    border: none;
    max-width: 1px;
}

/* === Group box === */
QGroupBox {
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_LARGE@;
    margin-top: 22px;
    padding: 12px;
    padding-top: 18px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    font-size: 13px;
    font-weight: 600;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
}

/* === Lists and trees === */
QListWidget {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_LARGE@;
    outline: none;
}

/* No padding: rows that carry their own widget (a label and a remove button)
 * fill the item rect, and padding would crush them. */
QListWidget::item {
    min-height: 44px;
    border-bottom: 1px solid #1e2530;
}

QTreeView {
    background-color: #0f1419;                      /* BASE */
    border: none;
    outline: none;
}

QTreeView::item {
    min-height: 44px;
}

QListWidget::item:selected,
QTreeView::item:selected {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    color: #38bdf8;                                 /* ACCENT */
}

QHeaderView::section {
    background-color: #0b0f14;                      /* CHROME */
    color: #718096;                                 /* TEXT_MUTED */
    border: none;
    border-bottom: 1px solid #1e2530;               /* BORDER */
    padding: 8px;
    font-size: 12px;
    font-weight: 600;
}

/* === Tabs (anything but the Pi dashboard's own, below) === */
QTabWidget::pane {
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_LARGE@;
    background-color: #0f1419;                      /* BASE */
}

QTabBar::tab {
    background-color: #0b0f14;                      /* CHROME */
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 14px;
    min-height: 42px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    border-bottom-color: #38bdf8;                   /* ACCENT */
}

QMainWindow::separator {
    background-color: #1e2530;                      /* BORDER */
    width: 4px;
    height: 4px;
}

/* === Menus: the ⚙ menu and every popup === */
QMenu {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_MEDIUM@;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 15px;
    min-height: 44px;
    padding: 0 32px 0 16px;
    border-radius: @RADIUS_SMALL@;
}

QMenu::item:selected {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    color: #38bdf8;                                 /* ACCENT */
}

QMenu::item:disabled {
    color: #718096;                                 /* TEXT_MUTED */
}

QMenu::separator {
    height: 1px;
    background-color: #1e2530;                      /* BORDER */
    margin: 6px 8px;
}

/* === Tool tip === */
QToolTip {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #e2e8f0;
    border: 1px solid #1e2530;
    border-radius: @RADIUS_MEDIUM@;
    padding: 8px;
    font-size: 13px;
}

QMessageBox QLabel {
    font-size: 16px;
}

QMessageBox QPushButton {
    min-width: 120px;
}

/* ============================================================================
 * The Pi header: row one is the status strip beside the ⚙ button, row two the
 * tabs. CHROME ground, a 1 px BORDER under each row.
 * ========================================================================= */

QWidget#piHeader {
    background-color: #0b0f14;                      /* CHROME */
}

QFrame#statusStrip,
QFrame#statusStripDevices {
    background-color: #0b0f14;                      /* CHROME */
    border: none;
}

QLabel#statusStripExperiment {
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 14px;
    font-weight: 600;
}

QLabel#statusStripDirty {
    color: #fbbf24;                                 /* WARNING */
    font-size: 12px;
}

/* The run pill. It is a tap target (back to Run mid-run), so the label keeps
 * the strip's full 44 px and the margin insets only the painted pill. */
QLabel#statusStripPill {
    background-color: #151c25;                      /* SURFACE_2 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 11px;  /* geometric: half of the 22 px pill */
    margin: 11px 0;
    padding: 0 8px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 11px;
    font-weight: bold;
}

QLabel#statusStripPill[state="running"] {
    background-color: rgba(52, 211, 153, 0.13);     /* SUCCESS @ 13% */
    border-color: rgba(52, 211, 153, 0.40);
    color: #34d399;                                 /* SUCCESS */
}

QLabel#statusStripPill[state="recording"] {
    background-color: rgba(248, 113, 113, 0.15);    /* ERROR @ 15% */
    border-color: rgba(248, 113, 113, 0.40);
    color: #f87171;                                 /* ERROR */
}

/* Error is the only filled thing in the header: nothing can out-shout it. */
QLabel#statusStripPill[state="error"] {
    background-color: #f87171;                      /* ERROR */
    border-color: #f87171;
    color: #0a0e13;                                 /* CANVAS */
}

/* A healthy board is a quiet dot and a name; a down one becomes a tinted
 * chip, so it differs from the boards beside it. Padding stays small: five
 * boards, the name and the pill share 436 px. */
QFrame#statusStripDevice {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 11px;  /* geometric: half of the 22 px chip */
    margin: 11px 0;
    padding: 0 2px;
}

QFrame#statusStripDevice[state="warn"] {
    background-color: rgba(251, 191, 36, 0.13);     /* WARNING @ 13% */
    border-color: rgba(251, 191, 36, 0.30);
    padding: 0 4px;
}

QFrame#statusStripDevice[state="error"] {
    background-color: rgba(248, 113, 113, 0.13);    /* ERROR @ 13% */
    border-color: rgba(248, 113, 113, 0.30);
    padding: 0 4px;
}

/* The name stays neutral: a chip's state can change after it was polished,
 * and only the chip and its dot are re-polished, so a state colour here would
 * go stale. The dot and the chip's tint carry the state. */
QLabel#statusStripDeviceName {
    background-color: transparent;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 12px;
}

QLabel#statusStripDot {
    background-color: #718096;                      /* TEXT_MUTED */
    color: #718096;
    border-radius: 4px;  /* geometric: half of the 8 px side */
}

QLabel#statusStripDot[state="ok"] {
    background-color: #34d399;                      /* SUCCESS */
    color: #34d399;
}

QLabel#statusStripDot[state="warn"] {
    background-color: #fbbf24;                      /* WARNING */
    color: #fbbf24;
}

QLabel#statusStripDot[state="error"] {
    background-color: #f87171;                      /* ERROR */
    color: #f87171;
}

QToolButton#piGearButton {
    background-color: #0b0f14;                      /* CHROME */
    border: none;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 22px;
    padding: 0;
}

QToolButton#piGearButton:pressed,
QToolButton#piGearButton:open {
    background-color: #151c25;                      /* SURFACE_2 */
    color: #e2e8f0;
}

QToolButton#piGearButton::menu-indicator {
    image: none;
    width: 0;
}

/* Row two: Experiment · Dashboard · Run, equal width, underlined when current. */
QFrame#shellTabBar {
    background-color: #0b0f14;                      /* CHROME */
}

QWidget#piHeader QFrame#shellTabBar {
    border-top: 1px solid #1e2530;                  /* BORDER */
    border-bottom: 1px solid #1e2530;
}

QToolButton#shellTab {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    border-radius: 0;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 15px;
    font-weight: 500;
    padding: 0 16px;
    min-height: 42px;
}

QToolButton#shellTab:checked {
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    border-bottom-color: #38bdf8;                   /* ACCENT */
}

/* The notice bar under the header: tinted by level, tap to dismiss. */
QFrame#piNoticeBar {
    border: none;
    border-bottom: 1px solid #1e2530;
    min-height: 44px;
    padding: 0 6px;
}

QFrame#piNoticeBar QLabel {
    font-size: 13px;
}

QFrame#piNoticeBar[level="info"] {
    background-color: rgba(56, 189, 248, 0.10);     /* ACCENT @ 10% */
    border-bottom-color: rgba(56, 189, 248, 0.30);
}

QFrame#piNoticeBar[level="info"] QLabel {
    color: #38bdf8;                                 /* ACCENT */
}

QFrame#piNoticeBar[level="warning"] {
    background-color: rgba(251, 191, 36, 0.12);     /* WARNING @ 12% */
    border-bottom-color: rgba(251, 191, 36, 0.35);
}

QFrame#piNoticeBar[level="warning"] QLabel {
    color: #fbbf24;                                 /* WARNING */
}

QFrame#piNoticeBar[level="critical"] {
    background-color: rgba(248, 113, 113, 0.18);    /* ERROR @ 18% */
    border-bottom-color: rgba(248, 113, 113, 0.45);
}

QFrame#piNoticeBar[level="critical"] QLabel {
    color: #f87171;                                 /* ERROR */
    font-weight: 600;
}

/* ============================================================================
 * Dashboard: the graph over the panel tabs.
 * ========================================================================= */

QSplitter#piDashboardSplitter::handle:vertical {
    background-color: #0b0f14;                      /* CHROME */
    border-top: 1px solid #1e2530;                  /* BORDER */
    height: 14px;
    image: url(@ICONS@/grip.svg);
}

QTabWidget#piDashboardTabs::pane {
    border: none;
    background-color: #0f1419;                      /* BASE */
}

QTabWidget#piDashboardTabs QTabBar {
    background-color: #0b0f14;                      /* CHROME */
}

QTabWidget#piDashboardTabs QTabBar::tab {
    background-color: #0b0f14;                      /* CHROME */
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    border: none;
    border-bottom: 1px solid #1e2530;               /* BORDER */
    padding: 0 4px;
    height: 47px;
    min-width: 0;
    font-size: 14px;
    font-weight: 500;
}

QTabWidget#piDashboardTabs QTabBar::tab:selected {
    color: #38bdf8;                                 /* ACCENT */
    border-bottom: 2px solid #38bdf8;
    height: 46px;
}

/* The edit lock on the graph: a quiet pill while locked, cyan while editing. */
QPushButton#graphLockButton {
    background-color: #151c25;                      /* SURFACE_2 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 22px;  /* geometric: half of the 44 px height */
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 13px;
    font-weight: 600;
    padding: 0 16px;
    min-height: 42px;
}

/* Opaque, like the locked look: a tint would let the graph show through. */
QPushButton#graphLockButton[locked="false"] {
    border-color: #38bdf8;                          /* ACCENT */
    color: #38bdf8;                                 /* ACCENT */
}

QPushButton#graphLockButton:disabled {
    color: #718096;                                 /* TEXT_MUTED */
}

/* ============================================================================
 * Run page
 * ========================================================================= */

QLabel#piRunClock {
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-family: "DejaVu Sans Mono", "Liberation Mono", Menlo, "SF Mono", monospace;
    font-size: 64px;
    font-weight: 600;
    padding: 8px 0;
}

QLabel#piRunClock[live="true"] {
    color: #34d399;                                 /* SUCCESS */
}

/* Run fields: tap to edit in place. */
QPushButton[fieldTag="true"] {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_MEDIUM@;
    color: #e2e8f0;                                 /* TEXT_PRIMARY */
    font-size: 13px;
    font-weight: 500;
    padding: 0 12px;
    min-height: 42px;
}

QPushButton[fieldTag="true"][need="true"] {
    background-color: rgba(251, 191, 36, 0.10);     /* WARNING @ 10% */
    border-color: rgba(251, 191, 36, 0.55);
    color: #fbbf24;                                 /* WARNING */
}

QPushButton[fieldTag="true"][locked="true"] {
    background-color: transparent;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
}

QLineEdit[fieldTagEditor="true"] {
    border-color: #38bdf8;                          /* ACCENT */
}

/* READY / NOT READY / NEEDS DETAILS, and the live states. */
QLabel[runnerStatus="true"],
QLabel[statusIndicator="true"] {
    background-color: #151c25;                      /* SURFACE_2 */
    border-radius: 11px;  /* geometric: half of the 23 px pill, rounded down */
    padding: 4px 12px;
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 12px;
    font-weight: bold;
}

QLabel[statusState="READY"] {
    background-color: rgba(52, 211, 153, 0.13);     /* SUCCESS @ 13% */
    color: #34d399;
}

QLabel[statusState="RUNNING"],
QLabel[statusState="INITIALIZING"] {
    background-color: rgba(56, 189, 248, 0.13);     /* ACCENT @ 13% */
    color: #38bdf8;
}

QLabel[statusState="PAUSED"],
QLabel[statusState="STOPPING"],
QLabel[statusState="NEEDS_DETAILS"] {
    background-color: rgba(251, 191, 36, 0.13);     /* WARNING @ 13% */
    color: #fbbf24;
}

QLabel[statusState="ERROR"] {
    background-color: rgba(248, 113, 113, 0.15);    /* ERROR @ 15% */
    color: #f87171;
}

/* Device cards: name and type; the state badge keeps its per-state colour. */
QWidget[deviceCard="true"] {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: @RADIUS_LARGE@;
}

QLabel#deviceCardName {
    font-size: 14px;
    font-weight: 600;
}

QLabel#deviceCardType {
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 12px;
}

/* ============================================================================
 * Experiment page: section chips across the top.
 * ========================================================================= */

QToolButton#experimentChip {
    background-color: #111820;                      /* SURFACE_1 */
    border: 1px solid #1e2530;                      /* BORDER */
    border-radius: 22px;  /* geometric: half of the 44 px chip */
    color: #94a3b8;                                 /* TEXT_TERTIARY */
    font-size: 13px;
    padding: 0 8px;
    min-height: 42px;
}

QToolButton#experimentChip:checked {
    background-color: rgba(56, 189, 248, 0.12);     /* ACCENT @ 12% */
    border-color: rgba(56, 189, 248, 0.50);
    color: #38bdf8;                                 /* ACCENT */
}

/* A form label is as tall as the 44 px field beside it, so its text sits on
 * the field's centre line rather than at its top edge. */
QWidget#experimentSection QGroupBox > QLabel {
    min-height: 44px;
}

/* ============================================================================
 * Shared roles
 * ========================================================================= */

QLabel[textRole="muted"] { color: #718096; font-size: 13px; }
QLabel[textRole="section"] { color: #718096; font-size: 12px; font-weight: bold; }
QLabel[textRole="secondary"] { color: #94a3b8; }
QLabel[textRole="primary"] { color: #e2e8f0; }
QLabel[textRole="disabled"] { color: #718096; }
QLabel[textRole="warning"] { color: #fbbf24; font-size: 13px; }

QLabel[inputValue="true"] {
    background-color: #151c25;                      /* SURFACE_2 */
    border-radius: @RADIUS_MEDIUM@;
    color: #34d399;                                 /* SUCCESS */
    padding: 4px 8px;
}

QLabel[recording="true"] {
    background-color: rgba(248, 113, 113, 0.15);    /* ERROR @ 15% */
    color: #f87171;
    padding: 4px 12px;
    border-radius: @RADIUS_MEDIUM@;
    font-size: 13px;
    font-weight: bold;
}

/* Properties panel section headers and dividers */
QLabel[class="props-section-header"] {
    color: #718096;                                 /* TEXT_MUTED */
    font-size: 12px;
    font-weight: bold;
    padding-top: 4px;
    padding-bottom: 2px;
}

QFrame[class="props-divider"] {
    color: #1e2530;                                 /* BORDER */
    margin-top: 4px;
    margin-bottom: 4px;
}

/* The Control tab's status strip: a persistent notice, a glyph and a tint per
 * level so it never relies on colour alone. */
QLabel#runnerStatusStrip {
    padding: 10px 14px;
    border-radius: @RADIUS_MEDIUM@;
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
    background-color: #151c25;                      /* SURFACE_2 */
}

QLabel#runnerStatusStrip[level="error"] {
    background-color: rgba(248, 113, 113, 0.15);
    color: #f87171;                                 /* ERROR */
}

QLabel#runnerStatusStrip[level="warn"] {
    background-color: rgba(251, 191, 36, 0.15);
    color: #fbbf24;                                 /* WARNING */
}

QLabel#runnerStatusStrip[level="info"] {
    background-color: rgba(56, 189, 248, 0.12);
    color: #38bdf8;                                 /* ACCENT */
}

/* Drag-and-drop target: the camera panel accepts pose models, behavior
 * models and videos. The accent border is the only feedback that a drop will
 * land somewhere. */
CameraPanel[dropActive="true"] {
    border: 2px dashed #38bdf8;
}
